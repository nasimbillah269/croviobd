# ---------------- Performance ----------------
# Compress text responses (HTML, CSS, JS, JSON, SVG, fonts)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Let browsers keep static files instead of downloading them on every page
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
# ---------------------------------------------

<IfModule mod_headers.c>
    # Pages (HTML) always fresh — cart, price and stock change often
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    # Static files: cacheable (overrides the no-cache above)
    <FilesMatch "(?i)\.(jpe?g|png|gif|webp|svg|ico|bmp|mp4|webm)$">
        Header set Cache-Control "public, max-age=2592000"
        Header unset Pragma
    </FilesMatch>
    <FilesMatch "(?i)\.(woff2?|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset Pragma
    </FilesMatch>
    <FilesMatch "(?i)\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
        Header unset Pragma
    </FilesMatch>
    Header append Vary "Accept-Encoding"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# LiteSpeed ক্যাশকে লারাভেলের জন্য ডিজেবল করার কমান্ড
<IfModule mod_litespeed.class>
    CacheDisable public /
    CacheDisable private /
</IfModule>

# Disable directory listing
Options -Indexes

# Block sensitive files (.env, composer, logs, backups, etc.)
<FilesMatch "(?i)(^\.|^error_log$|^artisan$|\.(env|json|md|lock|example|sql|bak|old|orig|swp|ini|log|sh|yml|yaml|xml\.dist)$)">
    Require all denied
</FilesMatch>

# Block dangerous / executable file types
<FilesMatch "(?i)\.(phtml|phar|pht|phps|exe|sh|bash|cgi|pl|py|jsp|asp|aspx)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # Pass Authorization headers (For API / Sanctum / Passport)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Force HTTPS (SSL)
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Hidden files/folders (.git, .env ...) except .well-known (SSL validation)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Laravel source folders must never be reachable from the web
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L]
    RewriteRule ^(artisan|server\.php|composer\.(json|lock)|package(-lock)?\.json|webpack\.mix\.js|phpunit\.xml|error_log)$ - [F,L]

    # Block common exploit query strings
    RewriteCond %{QUERY_STRING} base64_encode[^(]*\( [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C)[^>]*script[^>]*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (GLOBALS|_REQUEST)(=|\[|%[0-9A-Z]{0,2}) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|%2e%2e%2f|/etc/passwd|php://|data://|expect://) [NC]
    RewriteRule ^ - [F,L]

    # Redirect everything to /public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

